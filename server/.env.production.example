# ===================================================================
# SVCORA_SpendX Backend - Production Cloud Environment Configuration
# ===================================================================

# 1. Cloud Database Connection (from Neon.tech or Supabase, SSL required)
DATABASE_URL="postgresql://username:password@ep-your-project.neon.tech/spendx?sslmode=require"

# 2. Port (Render sets this automatically, default is 10000 or 3001)
PORT=10000

# 3. Cryptographic Secret for JWT Tokens (Must be at least 32 characters)
JWT_SECRET="spendx-production-jwt-secret-svcinfosystems-2026-secure-key"

# 4. CORS Allowed Origins (Comma-separated list of your frontend URLs)
CORS_ORIGIN="https://your-spendx-app.vercel.app,http://localhost:8080"

# 5. Environment
NODE_ENV="production"

# 6. Optional Transactional Email Configuration (SMTP)
# Leave blank for development log fallback, or provide credentials for real emails
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="info@svcinfosys.in"
