# SVCORA_SpendX server environment configuration
DATABASE_URL="postgresql://username:password@localhost:5432/svcora_spendx"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8080"
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USER="your-email@example.com"
EMAIL_PASS="REPLACE_WITH_EMAIL_PASSWORD"
EMAIL_FROM="noreply@svcinfosys.in"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"
BCRYPT_ROUNDS=12
SESSION_SECRET="REPLACE_WITH_A_RANDOM_SESSION_SECRET"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"
AWS_ACCESS_KEY_ID="REPLACE_WITH_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="REPLACE_WITH_AWS_SECRET_KEY"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="svcora-spendx-uploads"
REDIS_URL="redis://localhost:6379"
STRIPE_SECRET_KEY="REPLACE_WITH_STRIPE_SECRET_KEY"
STRIPE_PUBLISHABLE_KEY="REPLACE_WITH_STRIPE_PUBLISHABLE_KEY"
SENTRY_DSN="REPLACE_WITH_SENTRY_DSN"
SEED_ADMIN_EMAIL="admin@svcinfosys.in"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/svcora_spendx_test"
